{
	"name": "blog",
	"description": "基于 Next.js + Tailwind CSS + Motion + Content Collections + GitHub Actions + GitHub Issues 的个人博客",
	"keywords": [
		"nextjs",
		"tailwindcss",
		"motion",
		"content-collections",
		"github actions",
		"github issues",
		"blog"
	],
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start -p 3003",
		"start:static": "serve -s out -l 3003",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --write .",
		"sync-post": "node ./scripts/sync-post.js",
		"generate-rss": "node ./scripts/generate-rss.js",
		"copy-images": "node ./scripts/copy-post-images.js",
		"predev": "node ./scripts/copy-post-images.js",
		"prebuild": "node ./scripts/copy-post-images.js && node ./scripts/generate-rss.js",
		"prepare": "husky"
	},
	"dependencies": {
		"@content-collections/core": "^0.15.3",
		"@content-collections/mdx": "^0.2.2",
		"@content-collections/next": "^0.2.11",
		"@radix-ui/react-aspect-ratio": "^1.2.0",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-hover-card": "^1.2.1",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-navigation-menu": "^1.4.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-toast": "^1.3.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"class-variance-authority": "^0.7.1",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.23",
		"dotenv": "^16.4.5",
		"github-api": "^3.4.0",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.58.0",
		"motion": "^14.3.0",
		"next": "16.4.1",
		"next-themes": "^0.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-medium-image-zoom": "^5.4.9",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-prism-plus": "^2.0.2",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"rss": "^1.2.2",
		"server-only": "^0.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tocbot": "^4.36.8",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/rss": "^0.0.32",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.1",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"serve": "^14.2.4",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.2"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,md,mdx,json}": [
			"prettier --write"
		]
	}
}
