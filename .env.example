# 复制为 .env.local 后填写自己的值：cp .env.example .env.local

# 线上域名，用于 canonical / sitemap / RSS / og:url。
# 必须带 http(s) 前缀，结尾斜杠会自动去掉。
# 本地开发可以留空（会用 http://localhost:3000）；生产构建必须填。
NEXT_PUBLIC_SITE_URL="https://example.com"

# 站点部署在子路径时填这里，比如 GitHub Pages 项目站点的 "/blog"。
# 根域名部署（自有域名、Vercel）留空；改动后必须重新构建才会生效。
NEXT_PUBLIC_BASE_PATH=""

# 邮件相关，留空会回退到 noreply@example.com
NEXT_PUBLIC_SITE_EMAIL_FROM="you@example.com"

# 外链悬浮预览需要服务端 /api/link-preview，纯静态导出请保持 false
NEXT_PUBLIC_SITE_LINK_PREVIEW_ENABLED="false"

# 可选：站点统计（留空则不注入脚本）
# NEXT_PUBLIC_GOOGLE_ID="G-XXXXXXXXXX"

# 可选：搜索引擎站长校验
# NEXT_PUBLIC_GOOGLE_VERIFICATION=""
# NEXT_PUBLIC_BAIDU_VERIFICATION=""

# GitHub Actions 里通过 secrets 注入；本地跑 `pnpm sync-post` 时在这里填写
# GH_TOKEN="ghp_xxx"
# GH_USER="your-github-name"
# GH_PROJECT_NAME="issues-repo-name"
# 可选：允许多个作者，逗号分隔
# GH_CREATORS="your-github-name"
